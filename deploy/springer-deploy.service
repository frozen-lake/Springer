[Unit]
Description=Deploy the latest Springer commit to the bot
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=PATH=/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /srv/springer/deploy/springer-deploy.sh
TimeoutStartSec=2h
